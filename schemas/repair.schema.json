{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-forge.dev/schemas/repair.schema.json",
  "title": "Repair script",
  "description": "The ordered Repair operations for a Clip, at characters/<character-id>/repairs/<clip-id>/repair.json. Replayed in order on every run. See docs/format-spec.md and docs/repair.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": {
          "description": "Exclusive; the range is half-open [start, end).",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rectGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "strokeGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points", "size"],
      "properties": {
        "points": {
          "description": "A polyline stroke, in pixel coordinates; each point is [x, y].",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer" }
          }
        },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "frames", "geometry"],
      "properties": {
        "tool": { "enum": ["erase-rect", "erase-brush", "paint-brush"] },
        "frames": { "$ref": "#/$defs/frameRange" },
        "geometry": {},
        "color": {
          "description": "Required for paint-brush; forbidden for the erase tools.",
          "$ref": "#/$defs/hexColor"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "tool": { "const": "erase-rect" } }, "required": ["tool"] },
          "then": {
            "properties": { "geometry": { "$ref": "#/$defs/rectGeometry" } },
            "not": { "required": ["color"] }
          }
        },
        {
          "if": { "properties": { "tool": { "enum": ["erase-brush", "paint-brush"] } }, "required": ["tool"] },
          "then": { "properties": { "geometry": { "$ref": "#/$defs/strokeGeometry" } } }
        },
        {
          "if": { "properties": { "tool": { "const": "erase-brush" } }, "required": ["tool"] },
          "then": { "not": { "required": ["color"] } }
        },
        {
          "if": { "properties": { "tool": { "const": "paint-brush" } }, "required": ["tool"] },
          "then": { "required": ["color"] }
        }
      ]
    }
  }
}
