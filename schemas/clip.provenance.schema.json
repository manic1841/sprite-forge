{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprite-forge.dev/schemas/clip.provenance.schema.json",
  "title": "Clip provenance",
  "description": "How a committed Clip was made, at characters/<character-id>/clips/<clip-id>/provenance.json. See docs/format-spec.md and docs/recordings.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordingId", "recordingHash", "segment", "background", "spriteForgeVersion"],
  "properties": {
    "recordingId": {
      "description": "The Recording this Clip was cut from; assigned at ingest.",
      "$ref": "#/$defs/id"
    },
    "recordingHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "segment": {
      "description": "A snapshot of the resolved cut at Clip time; later re-cutting does not change it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["cutId", "startFrame", "endFrame", "speed"],
      "properties": {
        "cutId": { "$ref": "#/$defs/id" },
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 1 },
        "speed": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hex", "source", "tolerance"],
      "properties": {
        "hex": { "$ref": "#/$defs/hexColor" },
        "source": { "enum": ["sampled", "override"] },
        "tolerance": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "repair": {
      "description": "Path to this Clip's Repair script, relative to the store root. Omit (or null) when there is no Repair.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/relPath" }]
    },
    "placementOffset": {
      "description": "Manual placement on top of the automatic Anchor. Omitted when {0,0}.",
      "$ref": "#/$defs/offset"
    },
    "derivedFrom": {
      "description": "The Asset this Clip was forked from; null when not a fork.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/assetRef" }]
    },
    "spriteForgeVersion": { "type": "string" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "relPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*://).+$"
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["clip", "sequence"] },
        "id": { "$ref": "#/$defs/id" }
      }
    }
  }
}
